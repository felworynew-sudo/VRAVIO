{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRAVIO",
  "version": "0.0.1",
  "identifier": "com.vravio.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @vravio/web dev --port 5174 --strictPort",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm --filter @vravio/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRAVIO",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
